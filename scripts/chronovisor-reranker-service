#!/bin/sh
set -eu

CHRONOVISOR_WRAPPER_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
. "$CHRONOVISOR_WRAPPER_DIR/chronovisor-runtime-env"

chronovisor_exec_uvx --python "$CHRONOVISOR_PYTHON" \
  --refresh-package chronovisor \
  --with "torch==2.13.0" \
  --with "transformers==5.14.1" \
  --with "sentence-transformers==5.6.1" \
  --with "mlx==0.32.4" \
  --with "mlx-vlm==0.7.12" \
  --with "startlux-decide @ git+https://github.com/StartLuxLabs/StartLux-Decision@a99977d9332decc9fb27a2488b4a83b533b6cd5f" \
  --from "$RUNTIME_SOURCE" \
  chronovisor-reranker-service "$@"
