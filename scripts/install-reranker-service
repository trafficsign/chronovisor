#!/bin/zsh
set -euo pipefail

readonly SCRIPT_DIR="${0:A:h}"
readonly PROJECT_ROOT="${SCRIPT_DIR:h}"
readonly LAUNCH_AGENT="$HOME/.chronovisor/runtime/launchd-sources/com.trafficsign.chronovisor-reranker.plist"
readonly DOMAIN="gui/$(/usr/bin/id -u)"
readonly SERVICE_MANAGER="${CHRONOVISOR_SERVICE_MANAGER:-$PROJECT_ROOT/scripts/chronovisor-macos-services}"

mkdir -p "$HOME/.chronovisor/logs" "${LAUNCH_AGENT:h}"
"$PROJECT_ROOT/scripts/chronovisor-render-launchd" \
  "$PROJECT_ROOT/launchd/com.trafficsign.chronovisor-reranker.plist" \
  "$LAUNCH_AGENT" \
  --project-root "$PROJECT_ROOT" \
  --home "$HOME"
readonly LABEL="$(/usr/libexec/PlistBuddy -c 'Print :Label' "$LAUNCH_AGENT").managed-v2"
"$SERVICE_MANAGER" refresh reranker

status_matches_launchd() {
  local pid
  pid="$(
    /bin/launchctl print "$DOMAIN/$LABEL" 2>/dev/null \
      | /usr/bin/awk '$1 == "pid" && $2 == "=" { print $3; exit }'
  )"
  [[ "$pid" == <-> ]] || return 1
  /bin/kill -0 "$pid" 2>/dev/null || return 1
  /usr/bin/python3 - "$HOME/.chronovisor/runtime/reranker-service-status.json" "$pid" "$HOME/.chronovisor/runtime/reranker.sock" <<'PY'
import json
import os
import socket
import subprocess
import sys
from pathlib import Path

path = Path(sys.argv[1])
launchd_pid = int(sys.argv[2])
socket_path = Path(sys.argv[3])
try:
    status = json.loads(path.read_text(encoding="utf-8"))
    service_pid = int(status.get("pid") or 0)
except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
if status.get("ready") is not True or service_pid <= 0:
    raise SystemExit(1)
try:
    os.kill(service_pid, 0)
except OSError:
    raise SystemExit(1)

# uvx remains as launchd's direct child and starts the Python console script as
# its child. Accept the service PID only when launchd's PID is in that live
# ancestor chain, so a stale status file from another process cannot pass.
pid = service_pid
seen = set()
for _depth in range(8):
    if pid == launchd_pid:
        break
    if pid <= 1 or pid in seen:
        break
    seen.add(pid)
    try:
        parent = subprocess.run(
            ["/bin/ps", "-o", "ppid=", "-p", str(pid)],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        pid = int(parent)
    except (OSError, subprocess.CalledProcessError, ValueError):
        break
if pid != launchd_pid:
    raise SystemExit(1)

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(1.0)
        client.connect(str(socket_path))
        client.sendall(b'{"method":"health"}\n')
        response = client.recv(65536)
        payload = json.loads(response)
except (OSError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
raise SystemExit(0 if payload.get("status") in {"ok", "ready"} and payload.get("ready") is True else 1)
PY
}

for _attempt in {1..120}; do
  if [[ -S "$HOME/.chronovisor/runtime/reranker.sock" ]] \
    && status_matches_launchd; then
    print "Chronovisor reranker service is ready."
    exit 0
  fi
  /bin/sleep 0.5
done

print -u2 "Reranker service did not become ready; inspect ~/.chronovisor/logs/reranker.launchd.err.log"
exit 1
