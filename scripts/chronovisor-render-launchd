#!/usr/bin/env python3.14
from __future__ import annotations

import argparse
import os
import plistlib
import re
import shutil
import tempfile
import tomllib
from pathlib import Path
from typing import Any

PLACEHOLDER = re.compile(r"@@[A-Z_]+@@")
LABEL_PREFIX = re.compile(r"(?:[A-Za-z0-9][A-Za-z0-9-]*\.)+[A-Za-z0-9][A-Za-z0-9-]*-\Z")
DEFAULT_LABEL_PREFIX = "com.trafficsign.chronovisor-"
SYSTEM_PATHS = (
    "/opt/homebrew/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/opt/homebrew/sbin",
    "/usr/sbin",
    "/sbin",
)


def _absolute_directory(value: str, name: str) -> Path:
    path = Path(value)
    if not path.is_absolute() or not path.is_dir():
        raise SystemExit(f"{name} must be an existing absolute directory: {value}")
    return path.resolve()


def _executable(value: str | None, env_name: str, command: str) -> Path:
    selected = value or os.environ.get(env_name) or shutil.which(command)
    if not selected:
        raise SystemExit(f"{command} not found; set {env_name} to an absolute path")
    path = Path(selected)
    if not path.is_absolute() or not path.is_file() or not os.access(path, os.X_OK):
        raise SystemExit(
            f"{env_name} must reference an absolute executable: {selected}"
        )
    return path.resolve()


def _label_prefix(home: Path, override: str | None) -> str:
    configured = override or os.environ.get("CHRONOVISOR_LAUNCHD_LABEL_PREFIX")
    if configured is None:
        try:
            data = tomllib.loads(
                (home / ".chronovisor" / "config.toml").read_text(encoding="utf-8")
            )
        except (OSError, UnicodeError, tomllib.TOMLDecodeError):
            data = {}
        runtime = data.get("runtime") if isinstance(data, dict) else None
        configured = (
            runtime.get("launchd_label_prefix") if isinstance(runtime, dict) else None
        )
    prefix = configured if isinstance(configured, str) else DEFAULT_LABEL_PREFIX
    if LABEL_PREFIX.fullmatch(prefix) is None:
        raise SystemExit(
            "launchd label prefix must be a reverse-DNS prefix ending in '-'"
        )
    return prefix


def _strings(value: Any):
    if isinstance(value, str):
        yield value
    elif isinstance(value, list):
        for item in value:
            yield from _strings(item)
    elif isinstance(value, dict):
        for item in value.values():
            yield from _strings(item)


def _replace(value: Any, replacements: dict[str, str]) -> Any:
    if isinstance(value, str):
        for placeholder, replacement in replacements.items():
            value = value.replace(placeholder, replacement)
        return value
    if isinstance(value, list):
        return [_replace(item, replacements) for item in value]
    if isinstance(value, dict):
        return {key: _replace(item, replacements) for key, item in value.items()}
    return value


def main() -> int:
    parser = argparse.ArgumentParser(description="Render a Chronovisor launchd plist")
    parser.add_argument("template", type=Path)
    parser.add_argument("output", type=Path)
    parser.add_argument("--project-root", required=True)
    parser.add_argument("--home", required=True)
    parser.add_argument("--uvx")
    parser.add_argument("--python")
    parser.add_argument("--label-prefix")
    args = parser.parse_args()

    project_root = _absolute_directory(args.project_root, "project root")
    home = _absolute_directory(args.home, "home")
    payload = plistlib.loads(args.template.read_bytes())
    required = {
        match.group()
        for text in _strings(payload)
        for match in PLACEHOLDER.finditer(text)
    }
    known = {
        "@@PROJECT_ROOT@@",
        "@@HOME@@",
        "@@PATH@@",
        "@@UVX@@",
        "@@PYTHON@@",
        "@@LAUNCHD_LABEL_PREFIX@@",
    }
    if unknown := required - known:
        raise SystemExit(f"unknown launchd placeholders: {', '.join(sorted(unknown))}")

    uvx = (
        _executable(args.uvx, "CHRONOVISOR_UVX", "uvx")
        if "@@UVX@@" in required
        else None
    )
    python = (
        _executable(args.python, "CHRONOVISOR_PYTHON", "python3.14")
        if "@@PYTHON@@" in required
        else None
    )
    path_parts = [str(path.parent) for path in (uvx, python) if path]
    path_parts.extend(SYSTEM_PATHS)
    replacements = {
        "@@PROJECT_ROOT@@": str(project_root),
        "@@HOME@@": str(home),
        "@@PATH@@": ":".join(dict.fromkeys(path_parts)),
        "@@UVX@@": str(uvx or ""),
        "@@PYTHON@@": str(python or ""),
        "@@LAUNCHD_LABEL_PREFIX@@": _label_prefix(home, args.label_prefix),
    }
    rendered = _replace(payload, replacements)
    remaining = {
        match.group()
        for text in _strings(rendered)
        for match in PLACEHOLDER.finditer(text)
    }
    if remaining:
        raise SystemExit(
            f"unrendered launchd placeholders: {', '.join(sorted(remaining))}"
        )

    args.output.parent.mkdir(parents=True, exist_ok=True)
    data = plistlib.dumps(rendered, fmt=plistlib.FMT_XML, sort_keys=False)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            dir=args.output.parent, prefix=f".{args.output.name}.", delete=False
        ) as stream:
            temporary = Path(stream.name)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(0o644)
        os.replace(temporary, args.output)
        parent_fd = os.open(args.output.parent, os.O_RDONLY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    finally:
        if temporary and temporary.exists():
            temporary.unlink()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
