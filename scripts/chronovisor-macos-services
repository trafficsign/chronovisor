#!/usr/bin/env python3
"""Build the native macOS provider bundle for Chronovisor LaunchAgents."""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

PROJECT_ROOT = Path(__file__).resolve().parents[1]
MANAGER_SOURCE = PROJECT_ROOT / "macos" / "ChronovisorServiceManager.swift"
RUNNER_SOURCE = PROJECT_ROOT / "macos" / "ChronovisorServiceRunner.swift"
ICON_SOURCE = PROJECT_ROOT / "macos" / "Chronovisor.icns"
APP_NAME = "Chronovisor.app"
APP_IDENTIFIER = "com.trafficsign.chronovisor"
DEFAULT_SIGNING_IDENTITY = "Chronovisor Local Code Signing"
SIGNING_IDENTITY_ENV = "CHRONOVISOR_CODESIGN_IDENTITY"
MANAGER_PROGRAM = "Contents/MacOS/Chronovisor"
BUNDLE_PROGRAM = "Contents/Helpers/ChronovisorServiceRunner"
# ponytail: bump this only when the runner changes; local signing pins its CDHash.
MANAGED_LABEL_VERSION = 2
SERVICE_SUFFIXES = (
    "converge",
    "dashboard",
    "deadman-observer",
    "ingest-drain",
    "lan-dashboard",
    "librarian-review",
    "reranker",
    "searxng",
    "semantic",
    "sleep",
    "watchdog",
)
RETIRED_SUFFIXES = ("librarian-rollout", "library-evidence", "soak")


def _plist_name(suffix: str) -> str:
    return f"com.trafficsign.chronovisor-{suffix}.plist"


def _legacy_label(suffix: str) -> str:
    return f"com.trafficsign.chronovisor-{suffix}"


def _managed_label(suffix: str) -> str:
    return f"{_legacy_label(suffix)}.managed-v{MANAGED_LABEL_VERSION}"


def _legacy_labels(suffix: str) -> tuple[str, str]:
    label = _legacy_label(suffix)
    return label, f"{label}.managed"


def _source_plist(home: Path, installed_app: Path, suffix: str) -> Path:
    name = _plist_name(suffix)
    candidates = (
        home / ".chronovisor" / "runtime" / "launchd-sources" / name,
        home / "Library" / "LaunchAgents" / name,
        installed_app / "Contents" / "Library" / "LaunchAgents" / name,
    )
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    agents = installed_app / "Contents" / "Library" / "LaunchAgents"
    for candidate in agents.glob("*.plist"):
        try:
            label = plistlib.loads(candidate.read_bytes()).get("Label")
        except (OSError, plistlib.InvalidFileException):
            continue
        if label in {
            f"{_legacy_label(suffix)}.managed",
            _managed_label(suffix),
        }:
            return candidate
    raise FileNotFoundError(f"missing source LaunchAgent: {name}")


def bundled_plist(payload: dict[str, Any], suffix: str) -> dict[str, Any]:
    label = payload.get("Label")
    base_label = _legacy_label(suffix)
    if label not in {base_label, f"{base_label}.managed", _managed_label(suffix)}:
        raise ValueError(f"unexpected LaunchAgent label for {suffix}: {label!r}")
    arguments = payload.get("ProgramArguments")
    wrapper = payload.get("BundleProgram")
    if (
        wrapper in {MANAGER_PROGRAM, BUNDLE_PROGRAM}
        and isinstance(arguments, list)
        and arguments[:2] == [wrapper, "run"]
    ):
        arguments = arguments[2:]
    if not isinstance(arguments, list) or not arguments:
        program = payload.get("Program")
        arguments = [program] if isinstance(program, str) else []
    if not arguments or not all(isinstance(value, str) for value in arguments):
        raise ValueError(f"invalid ProgramArguments for {label}")
    executable = Path(arguments[0])
    if (
        not executable.is_absolute()
        or not executable.is_file()
        or not os.access(executable, os.X_OK)
    ):
        raise ValueError(f"service executable is unavailable: {executable}")
    bundled = dict(payload)
    bundled["Label"] = _managed_label(suffix)
    bundled.pop("Program", None)
    bundled["BundleProgram"] = BUNDLE_PROGRAM
    bundled["ProgramArguments"] = [BUNDLE_PROGRAM, "run", *arguments]
    bundled.pop("AssociatedBundleIdentifiers", None)
    return bundled


def _managed_service(app: Path, suffix: str) -> tuple[str, str]:
    agents = app / "Contents" / "Library" / "LaunchAgents"
    fallback: tuple[str, str] | None = None
    for path in sorted(agents.glob("*.plist")):
        payload = plistlib.loads(path.read_bytes())
        label = payload.get("Label")
        if label == _managed_label(suffix):
            return path.name, label
        if label == f"{_legacy_label(suffix)}.managed":
            fallback = (path.name, label)
    if fallback is not None:
        return fallback
    raise FileNotFoundError(f"managed LaunchAgent not found for {suffix}")


def _write_info_plist(app: Path) -> None:
    payload = {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleDisplayName": "Chronovisor",
        "CFBundleExecutable": "Chronovisor",
        "CFBundleIdentifier": APP_IDENTIFIER,
        "CFBundleIconFile": ICON_SOURCE.name,
        "CFBundleInfoDictionaryVersion": "6.0",
        "CFBundleName": "Chronovisor",
        "CFBundlePackageType": "APPL",
        "CFBundleShortVersionString": "1.0",
        "CFBundleVersion": "1",
        "LSBackgroundOnly": True,
        "LSMinimumSystemVersion": "13.0",
    }
    (app / "Contents" / "Info.plist").write_bytes(
        plistlib.dumps(payload, fmt=plistlib.FMT_XML, sort_keys=False)
    )


def _signing_identity(explicit: str | None = None) -> str:
    identity = (
        explicit
        if explicit is not None
        else os.environ.get(SIGNING_IDENTITY_ENV, DEFAULT_SIGNING_IDENTITY)
    ).strip()
    if not identity or identity == "-":
        raise ValueError("Chronovisor.app requires a non-ad-hoc signing identity")
    return identity


def _signature_authority(details: str) -> str:
    if "Signature=adhoc" in details:
        raise RuntimeError("Chronovisor.app was signed ad-hoc")
    for line in details.splitlines():
        if line.startswith("Authority="):
            return line.removeprefix("Authority=")
    raise RuntimeError("Chronovisor.app has no signing authority")


def build_app(
    home: Path,
    destination: Path,
    signing_identity: str | None = None,
) -> dict[str, Any]:
    if destination.name != APP_NAME:
        raise ValueError(f"app destination must end with {APP_NAME}")
    identity = _signing_identity(signing_identity)
    swiftc = shutil.which("swiftc") or shutil.which("xcrun")
    codesign = shutil.which("codesign")
    if swiftc is None or codesign is None:
        raise RuntimeError("Swift compiler and codesign are required")
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(
        prefix="chronovisor-app-", dir=destination.parent
    ) as temporary:
        app = Path(temporary) / APP_NAME
        executable = app / MANAGER_PROGRAM
        runner = app / BUNDLE_PROGRAM
        agents = app / "Contents" / "Library" / "LaunchAgents"
        resources = app / "Contents" / "Resources"
        executable.parent.mkdir(parents=True)
        runner.parent.mkdir(parents=True)
        agents.mkdir(parents=True)
        resources.mkdir(parents=True)
        _write_info_plist(app)
        shutil.copy2(ICON_SOURCE, resources / ICON_SOURCE.name)
        bundled_services: list[str] = []
        for suffix in SERVICE_SUFFIXES:
            try:
                source = _source_plist(home, destination, suffix)
            except FileNotFoundError:
                continue
            payload = plistlib.loads(source.read_bytes())
            bundled = bundled_plist(payload, suffix)
            (agents / f"{bundled['Label']}.plist").write_bytes(
                plistlib.dumps(
                    bundled,
                    fmt=plistlib.FMT_XML,
                    sort_keys=False,
                )
            )
            bundled_services.append(suffix)
        if not bundled_services:
            raise RuntimeError("no Chronovisor LaunchAgent sources found")
        compiler = [swiftc]
        if Path(swiftc).name == "xcrun":
            compiler.extend(["swiftc"])
        subprocess.run(
            [
                *compiler,
                "-O",
                "-framework",
                "ServiceManagement",
                str(MANAGER_SOURCE),
                "-o",
                str(executable),
            ],
            check=True,
        )
        subprocess.run(
            [*compiler, "-O", str(RUNNER_SOURCE), "-o", str(runner)],
            check=True,
        )
        subprocess.run(
            [
                codesign,
                "--force",
                "--sign",
                identity,
                "--identifier",
                f"{APP_IDENTIFIER}.service-runner",
                str(runner),
            ],
            check=True,
        )
        subprocess.run(
            [
                codesign,
                "--force",
                "--sign",
                identity,
                "--identifier",
                APP_IDENTIFIER,
                str(app),
            ],
            check=True,
        )
        subprocess.run(
            [codesign, "--verify", "--deep", "--strict", str(app)], check=True
        )
        signature = subprocess.run(
            [codesign, "-dvvv", str(app)],
            check=True,
            capture_output=True,
            text=True,
        )
        authority = _signature_authority(signature.stdout + signature.stderr)
        staged = destination.with_name(f".{APP_NAME}.new")
        if staged.exists():
            shutil.rmtree(staged)
        shutil.copytree(app, staged, symlinks=True)
        if destination.exists():
            backup = destination.with_name(f".{APP_NAME}.previous")
            if backup.exists():
                shutil.rmtree(backup)
            os.replace(destination, backup)
        os.replace(staged, destination)
    return {
        "status": "ok",
        "app": str(destination),
        "services": bundled_services,
        "retired": list(RETIRED_SUFFIXES),
        "signing_authority": authority,
    }


def _manager(
    app: Path, command: str, *arguments: str
) -> subprocess.CompletedProcess[str]:
    executable = app / MANAGER_PROGRAM
    return subprocess.run(
        [str(executable), command, *arguments],
        check=False,
        capture_output=True,
        text=True,
    )


def _service_is_registered(app: Path, plist_name: str) -> bool:
    completed = _manager(app, "status")
    if completed.returncode != 0:
        raise RuntimeError(completed.stdout.strip() or completed.stderr.strip())
    try:
        services = json.loads(completed.stdout)["services"]
        row = next(item for item in services if item.get("plist") == plist_name)
        status = row["status"]
    except (json.JSONDecodeError, KeyError, StopIteration, TypeError) as exc:
        raise RuntimeError(f"invalid service status for {plist_name}") from exc
    if not isinstance(status, str):
        raise RuntimeError(f"invalid service status for {plist_name}")
    return status not in {"not_registered", "not_found"}


def _retire_legacy_service(home: Path, suffix: str) -> None:
    failures: list[str] = []
    for label in _legacy_labels(suffix):
        target = f"gui/{os.getuid()}/{label}"
        bootout = subprocess.run(
            ["/bin/launchctl", "bootout", target],
            check=False,
            capture_output=True,
            text=True,
        )
        registered = subprocess.run(
            ["/bin/launchctl", "print", target],
            check=False,
            capture_output=True,
            text=True,
        )
        if registered.returncode == 0:
            failures.append(
                bootout.stderr.strip() or f"legacy service remains registered: {label}"
            )
    if failures:
        raise RuntimeError("; ".join(failures))
    for label in _legacy_labels(suffix):
        (home / "Library" / "LaunchAgents" / f"{label}.plist").unlink(
            missing_ok=True
        )


def _verify_managed_service(home: Path, suffix: str, managed_label: str) -> None:
    legacy_present = False
    for label in _legacy_labels(suffix):
        legacy = subprocess.run(
            ["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"],
            check=False,
            capture_output=True,
            text=True,
        )
        legacy_plist = home / "Library" / "LaunchAgents" / f"{label}.plist"
        legacy_present = legacy_present or legacy.returncode == 0 or legacy_plist.exists()
    if not legacy_present:
        return
    target = f"gui/{os.getuid()}/{managed_label}"
    kickstart = subprocess.run(
        ["/bin/launchctl", "kickstart", target],
        check=False,
        capture_output=True,
        text=True,
    )
    if kickstart.returncode != 0:
        raise RuntimeError(kickstart.stderr.strip() or "managed kickstart failed")
    time.sleep(2)
    status = subprocess.run(
        ["/bin/launchctl", "print", target],
        check=False,
        capture_output=True,
        text=True,
    )
    lines = {line.strip() for line in status.stdout.splitlines()}
    launch_failed = (
        "job state = spawn failed" in lines
        or "last exit reason = OS_REASON_CODESIGNING" in lines
    )
    if (
        status.returncode != 0
        or launch_failed
        or not ("state = running" in lines or "last exit code = 0" in lines)
    ):
        raise RuntimeError(
            status.stderr.strip()
            or status.stdout.strip()
            or "managed service did not start successfully"
        )


def refresh_service(
    home: Path,
    app: Path,
    suffix: str,
    signing_identity: str | None = None,
) -> dict[str, Any]:
    previous_plist: str | None = None
    was_registered = False
    if app.is_dir():
        previous_plist, _ = _managed_service(app, suffix)
        try:
            was_registered = _service_is_registered(app, previous_plist)
        except RuntimeError as exc:
            return {
                "status": "error",
                "service": suffix,
                "phase": "status",
                "detail": str(exc),
            }
        if was_registered:
            unregister = _manager(app, "unregister-one", previous_plist)
            if unregister.returncode != 0:
                return {
                    "status": "error",
                    "service": suffix,
                    "phase": "unregister",
                    "detail": unregister.stdout.strip() or unregister.stderr.strip(),
                }
            # smd commits removal asynchronously even after unregister returns.
            time.sleep(3)
    try:
        build_app(home, app, signing_identity)
    except Exception:
        if was_registered and previous_plist is not None:
            _manager(app, "register-one", previous_plist)
        raise
    plist_name, label = _managed_service(app, suffix)
    register = _manager(app, "register-one", plist_name)
    if register.returncode != 0:
        _manager(app, "open-settings")
        return {
            "status": "error",
            "service": suffix,
            "phase": "register",
            "detail": register.stdout.strip() or register.stderr.strip(),
        }
    if was_registered:
        # launchd can retain the replaced bundle's lightweight code
        # requirement until it sees one enrollment against the stable bundle.
        time.sleep(2)
        reenroll = _manager(app, "unregister-one", plist_name)
        if reenroll.returncode != 0:
            return {
                "status": "error",
                "service": suffix,
                "phase": "reenroll-unregister",
                "detail": reenroll.stdout.strip() or reenroll.stderr.strip(),
            }
        time.sleep(3)
        register = _manager(app, "register-one", plist_name)
        if register.returncode != 0:
            _manager(app, "open-settings")
            return {
                "status": "error",
                "service": suffix,
                "phase": "reenroll-register",
                "detail": register.stdout.strip() or register.stderr.strip(),
            }
    try:
        _verify_managed_service(home, suffix, label)
    except RuntimeError as exc:
        return {
            "status": "error",
            "service": suffix,
            "phase": "verify-managed",
            "detail": str(exc),
        }
    try:
        _retire_legacy_service(home, suffix)
    except RuntimeError as exc:
        return {
            "status": "error",
            "service": suffix,
            "phase": "retire-legacy",
            "detail": str(exc),
        }
    return {
        "status": "ok",
        "service": suffix,
        "plist": plist_name,
        "label": label,
        "phase": "ready",
        "detail": "",
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command",
        choices=(
            "build",
            "refresh",
            "register",
            "unregister",
            "status",
            "open-settings",
        ),
    )
    parser.add_argument("service", nargs="?", choices=SERVICE_SUFFIXES)
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument("--app", type=Path)
    parser.add_argument("--signing-identity")
    args = parser.parse_args()
    home = args.home.expanduser().resolve()
    app = (
        args.app.expanduser().resolve()
        if args.app
        else home / "Applications" / APP_NAME
    )
    if args.command == "build":
        print(
            json.dumps(
                build_app(home, app, args.signing_identity),
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0
    if args.command == "refresh":
        if args.service is None:
            parser.error("refresh requires a service")
        payload = refresh_service(
            home,
            app,
            args.service,
            args.signing_identity,
        )
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0 if payload["status"] == "ok" else 1
    if args.service is not None:
        parser.error(f"{args.command} does not accept a service")
    completed = _manager(app, args.command)
    print(completed.stdout, end="")
    if completed.stderr:
        print(completed.stderr, end="", file=sys.stderr)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
