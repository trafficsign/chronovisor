#!/bin/sh
# Capture deadman: a macOS notification when capture stops or reports failures.
# Independent of the capture runtime: only sh, plutil, date and osascript.
set -u
umask 077

ROOT=${CHRONOVISOR_ROOT:-$HOME/.chronovisor}
RUN=$ROOT/runtime
STATUS=$RUN/capture-status.json
STATE=$RUN/deadman-state
MAX_AGE=900   # seconds without a completed capture run
REPEAT=3600   # re-alert a stopped capture hourly; failures only when their count grows

now=$(date -u +%s)
field() { plutil -extract "$1" raw -o - "$STATUS" 2>/dev/null; }
epoch() { date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null; }

if [ ! -f "$STATUS" ] || [ -L "$STATUS" ]; then
	condition=missing
elif [ "$(field version)" != 1 ]; then
	condition=invalid
else
	failed=$(field failed)
	success=$(epoch "$(field last_success_at)") || success=
	case $failed in
	'' | *[!0-9]*) condition=invalid ;;
	0)
		if [ -z "$success" ] || [ $((now - success)) -gt $MAX_AGE ]; then
			condition=stale
		else
			condition=healthy
		fi
		;;
	*) condition=failed ;;
	esac
fi

last_condition=healthy
last_alert=0
last_failed=0
[ -f "$STATE" ] && [ ! -L "$STATE" ] && read -r last_condition last_alert last_failed <"$STATE"
case $last_alert in '' | *[!0-9]*) last_alert=0 ;; esac
case $last_failed in '' | *[!0-9]*) last_failed=0 ;; esac
[ "$condition" = failed ] || failed=0

alerted=false
if [ "$condition" = healthy ]; then
	last_alert=0
elif [ "$condition" != "$last_condition" ] ||
	{ [ "$condition" = failed ] && [ "$failed" -gt "$last_failed" ]; } ||
	{ [ "$condition" != failed ] && [ $((now - last_alert)) -ge $REPEAT ]; }; then
	osascript -e "display notification \"Capture is $condition.\" with title \"Chronovisor\"" >/dev/null 2>&1 || true
	alerted=true
	last_alert=$now
fi

write() { printf '%s\n' "$2" >"$1.tmp" && mv -f "$1.tmp" "$1"; }
write "$STATE" "$condition $last_alert $failed"
[ "$condition" = healthy ] && status=healthy || status=alert
write "$RUN/deadman-status.json" "{\"version\": 1, \"status\": \"$status\", \"condition\": \"$condition\", \"observed_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"alerted\": $alerted}"
