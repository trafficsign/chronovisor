#!/bin/sh

chronovisor_resolve_executable() {
  chronovisor_value=$1
  shift
  if [ -z "$chronovisor_value" ]; then
    for chronovisor_name do
      chronovisor_value=$(command -v "$chronovisor_name" 2>/dev/null || true)
      [ -n "$chronovisor_value" ] && break
    done
  fi
  case "$chronovisor_value" in
    /*) ;;
    *) echo "required executable not found: $*" >&2; return 127 ;;
  esac
  [ -f "$chronovisor_value" ] && [ -x "$chronovisor_value" ] || {
    echo "not executable: $chronovisor_value" >&2
    return 126
  }
  printf '%s\n' "$chronovisor_value"
}

chronovisor_runtime_source() {
  "$CHRONOVISOR_PYTHON" - "$CHRONOVISOR_ROOT/config.toml" \
    "$CHRONOVISOR_REPO_ROOT/chronovisor-contract-manifest.json" <<'PY'
import json
import sys
import tomllib
from pathlib import Path

config_path, manifest_path = map(Path, sys.argv[1:])
try:
    runtime = tomllib.loads(config_path.read_text(encoding="utf-8")).get("runtime", {})
except (OSError, UnicodeError, tomllib.TOMLDecodeError):
    runtime = {}
source = runtime.get("source") if isinstance(runtime, dict) else None
if (
    not isinstance(source, str)
    or not source
    or source != source.strip()
    or any(ord(character) < 32 or ord(character) == 127 for character in source)
):
    repository = json.loads(manifest_path.read_text(encoding="utf-8"))["canonical"]["github"]
    source = f"git+https://github.com/{repository}.git"
print(source)
PY
}

chronovisor_exec_uvx() {
  chronovisor_constraints="$CHRONOVISOR_ROOT/runtime/dependency-constraints/${0##*/}.txt"
  if [ -z "${UV_CONSTRAINT:-}" ] && [ -f "$chronovisor_constraints" ]; then
    exec "$CHRONOVISOR_UVX" --constraints "$chronovisor_constraints" "$@"
  fi
  exec "$CHRONOVISOR_UVX" "$@"
}

: "${HOME:?HOME is required}"
CHRONOVISOR_WRAPPER_DIR=${CHRONOVISOR_WRAPPER_DIR:-$(CDPATH= cd "$(dirname "$0")" && pwd -P)}
CHRONOVISOR_REPO_ROOT=${CHRONOVISOR_REPO_ROOT:-$(dirname "$CHRONOVISOR_WRAPPER_DIR")}
case "$CHRONOVISOR_REPO_ROOT" in
  /*) ;;
  *) echo "CHRONOVISOR_REPO_ROOT must be absolute" >&2; exit 64 ;;
esac
[ -d "$CHRONOVISOR_REPO_ROOT" ] || {
  echo "repository root does not exist: $CHRONOVISOR_REPO_ROOT" >&2
  exit 66
}

CHRONOVISOR_UVX=$(chronovisor_resolve_executable "${CHRONOVISOR_UVX:-}" uvx)
CHRONOVISOR_PYTHON=$(chronovisor_resolve_executable "${CHRONOVISOR_PYTHON:-}" python3.14)
"$CHRONOVISOR_PYTHON" -c 'import sys; raise SystemExit(not (sys.version_info[:2] == (3, 14) and getattr(sys, "_is_gil_enabled", lambda: False)()))' || {
  echo "standard GIL Python 3.14 executable required" >&2
  exit 64
}
CHRONOVISOR_ROOT=${CHRONOVISOR_ROOT:-$HOME/.chronovisor}
RUNTIME_SOURCE=${CHRONOVISOR_RUNTIME_SOURCE:-$(chronovisor_runtime_source)}
export CHRONOVISOR_REPO_ROOT CHRONOVISOR_ROOT CHRONOVISOR_UVX CHRONOVISOR_PYTHON
