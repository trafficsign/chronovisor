#!/bin/sh
set -eu

# Reconcile new and changed pages before reviewing placement anomalies.  The
# rollout process is intentionally one-shot, so this periodic worker owns the
# post-release collection catch-up path.  State and receipts are persisted by
# the Librarian; suppress the very large registry JSON from the launchd log.
CHRONOVISOR_WRAPPER_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
. "$CHRONOVISOR_WRAPPER_DIR/chronovisor-runtime-env"

"$CHRONOVISOR_UVX" --python "$CHRONOVISOR_PYTHON" \
  --refresh-package chronovisor \
  --from "$RUNTIME_SOURCE" \
  chronovisor-librarian \
  --root "$CHRONOVISOR_ROOT" \
  --full-sweep \
  --json \
  >/dev/null

"$CHRONOVISOR_UVX" --python "$CHRONOVISOR_PYTHON" \
  --refresh-package chronovisor \
  --from "$RUNTIME_SOURCE" \
  chronovisor-librarian \
  --root "$CHRONOVISOR_ROOT" \
  --review-collection-queue \
  --limit "${CHRONOVISOR_LIBRARIAN_REVIEW_LIMIT:-5}" \
  --review-model "${CHRONOVISOR_LIBRARIAN_REVIEW_MODEL:-gemma4:26b-optiq4}" \
  --review-role primary \
  --json

exec "$CHRONOVISOR_UVX" --python "$CHRONOVISOR_PYTHON" \
  --refresh-package chronovisor \
  --from "$RUNTIME_SOURCE" \
  chronovisor-librarian \
  --root "$CHRONOVISOR_ROOT" \
  --review-collection-queue \
  --limit "${CHRONOVISOR_LIBRARIAN_CHALLENGE_LIMIT:-5}" \
  --review-model "${CHRONOVISOR_LIBRARIAN_CHALLENGER_MODEL:-gpt-oss:20b}" \
  --review-role challenger \
  --json
