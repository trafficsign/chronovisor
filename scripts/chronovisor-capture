#!/bin/sh
set -eu

CHRONOVISOR_WRAPPER_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
. "$CHRONOVISOR_WRAPPER_DIR/chronovisor-runtime-env"

# The capture run shares the converge dependency set; there is no
# chronovisor-capture.txt.
CHRONOVISOR_CONSTRAINTS="$CHRONOVISOR_ROOT/runtime/dependency-constraints/chronovisor-converge.txt"
export CHRONOVISOR_CONSTRAINTS

# No --refresh-package: the source is pinned to a commit, and this runs every 120 s.
chronovisor_exec_uvx --python "$CHRONOVISOR_PYTHON" \
  --from "$RUNTIME_SOURCE" \
  chronovisor-capture "$@"
