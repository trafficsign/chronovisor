#!/bin/sh
set -eu

SERVICE="${1:-}"
case "$SERVICE" in
  dashboard|lan-dashboard|ingest-drain|librarian-review|library-evidence) ;;
  *)
    printf 'usage: %s {dashboard|lan-dashboard|ingest-drain|librarian-review|library-evidence}\n' "$0" >&2
    exit 64
    ;;
esac

SCRIPT_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd -P)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.trafficsign.chronovisor-$SERVICE.plist"
DOMAIN="gui/$(id -u)"
LAUNCHCTL="${CHRONOVISOR_LAUNCHCTL:-/bin/launchctl}"
PYTHON="${CHRONOVISOR_PYTHON:-python3}"
readonly SERVICE SCRIPT_DIR PROJECT_ROOT LAUNCH_AGENT DOMAIN LAUNCHCTL PYTHON

mkdir -p \
  "$HOME/.chronovisor/logs" \
  "$HOME/.chronovisor/runtime/librarian" \
  "${LAUNCH_AGENT%/*}"
"$PYTHON" "$PROJECT_ROOT/scripts/chronovisor-render-launchd" \
  "$PROJECT_ROOT/launchd/com.trafficsign.chronovisor-$SERVICE.plist" \
  "$LAUNCH_AGENT" \
  --project-root "$PROJECT_ROOT" \
  --home "$HOME"
LABEL="$("$PYTHON" -c 'import plistlib, sys; print(plistlib.load(open(sys.argv[1], "rb"))["Label"])' "$LAUNCH_AGENT")"
readonly LABEL

"$LAUNCHCTL" bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
attempt=0
while [ "$attempt" -lt 20 ]; do
  if "$LAUNCHCTL" bootstrap "$DOMAIN" "$LAUNCH_AGENT" >/dev/null 2>&1; then
    break
  fi
  attempt=$((attempt + 1))
  /bin/sleep 0.25
done
if ! "$LAUNCHCTL" print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
  "$LAUNCHCTL" bootstrap "$DOMAIN" "$LAUNCH_AGENT"
fi
"$LAUNCHCTL" kickstart -k "$DOMAIN/$LABEL"
