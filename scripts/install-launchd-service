#!/bin/zsh
set -euo pipefail

readonly SERVICE="${1:-}"
case "$SERVICE" in
  dashboard | ingest-drain | librarian-review | library-evidence) ;;
  *)
    print -u2 "usage: $0 {dashboard|ingest-drain|librarian-review|library-evidence}"
    exit 64
    ;;
esac

readonly SCRIPT_DIR="${0:A:h}"
readonly PROJECT_ROOT="${SCRIPT_DIR:h}"
readonly LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.trafficsign.chronovisor-$SERVICE.plist"
readonly DOMAIN="gui/$(/usr/bin/id -u)"
readonly LAUNCHCTL="${CHRONOVISOR_LAUNCHCTL:-/bin/launchctl}"

mkdir -p \
  "$HOME/.chronovisor/logs" \
  "$HOME/.chronovisor/runtime/librarian" \
  "${LAUNCH_AGENT:h}"
"$PROJECT_ROOT/scripts/chronovisor-render-launchd" \
  "$PROJECT_ROOT/launchd/com.trafficsign.chronovisor-$SERVICE.plist" \
  "$LAUNCH_AGENT" \
  --project-root "$PROJECT_ROOT" \
  --home "$HOME"
readonly LABEL="$(/usr/libexec/PlistBuddy -c 'Print :Label' "$LAUNCH_AGENT")"

"$LAUNCHCTL" bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
"$LAUNCHCTL" bootstrap "$DOMAIN" "$LAUNCH_AGENT"
"$LAUNCHCTL" kickstart -k "$DOMAIN/$LABEL"
