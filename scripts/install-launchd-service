#!/bin/sh
set -eu

SERVICE="${1:-}"
case "$SERVICE" in
  dashboard|lan-dashboard|ingest-drain|librarian-review) ;;
  *)
    printf 'usage: %s {dashboard|lan-dashboard|ingest-drain|librarian-review}\n' "$0" >&2
    exit 64
    ;;
esac

SCRIPT_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd -P)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
LAUNCH_AGENT="$HOME/.chronovisor/runtime/launchd-sources/com.trafficsign.chronovisor-$SERVICE.plist"
SERVICE_MANAGER="${CHRONOVISOR_SERVICE_MANAGER:-$PROJECT_ROOT/scripts/chronovisor-macos-services}"
PYTHON="${CHRONOVISOR_PYTHON:-python3.14}"
readonly SERVICE SCRIPT_DIR PROJECT_ROOT LAUNCH_AGENT SERVICE_MANAGER PYTHON

mkdir -p \
  "$HOME/.chronovisor/logs" \
  "$HOME/.chronovisor/runtime/librarian" \
  "${LAUNCH_AGENT%/*}"
"$PYTHON" "$PROJECT_ROOT/scripts/chronovisor-render-launchd" \
  "$PROJECT_ROOT/launchd/com.trafficsign.chronovisor-$SERVICE.plist" \
  "$LAUNCH_AGENT" \
  --project-root "$PROJECT_ROOT" \
  --home "$HOME"
"$SERVICE_MANAGER" refresh "$SERVICE"
