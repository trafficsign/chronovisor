# Minimal production-supported local-only configuration.
# Copy to ~/.chronovisor/config.toml and keep the destination mode 0600.

[raw]
layout = "v2"

[hooks.user_prompt]
recall = true

[hooks.stop]
save = true
audit = false
content_correction = true
recall_improve = false

[embedding]
model = "bge-m3"

[search.embedding]
enabled = false

[search.reranker]
# Model/provider selection lives only in llm.roles."search.rerank".
enabled = false
top_n = 10
weight = 1.0

[search.reranker.service]
enabled = false
socket = "~/.chronovisor/runtime/reranker.sock"
timeout_ms = 1000
# off | shadow | canary | on
mode = "off"
canary_percent = 0
queue_size = 8

[ingest]
# Numeric generation limits live here; the model is selected only by the
# fixed llm.roles."ingest.generation" route below.

[decision_router]
# Production voters are selected only by the fixed classification roles below.
# These model fields remain compatibility defaults for injected/offline routers.
primary_model = "maxwell1500/ornith-35b:Q5_K_M"
challenger_model = "muse-glimmer:30b-mxfp8-dflash"
tie_break_model = "gemma4:26b"

[research]
enabled = false
mode = "explicit"

[research.web]
adapter_enabled = false
live_egress_enabled = false

[llm.providers.local]
kind = "ollama"

[llm.providers.local_reranker]
kind = "local-transformers"
backend = "transformers"
batch_size = 10
max_length = 384

[llm.providers.semantic_foreground]
kind = "nemotron"
device = "mps"

[llm.providers.semantic_incremental]
kind = "nemotron"
device = "cpu"

[llm.roles."knowledge.embedding"]
capability = "embedding"
provider = "local"
model = "bge-m3"

[llm.roles."knowledge.relation_extraction"]
capability = "generation"
provider = "local"
model = "gemma4:26b"

[llm.roles."knowledge.community_summary"]
capability = "generation"
provider = "local"
model = "gemma4:26b"

[llm.roles."classification.embedding"]
capability = "embedding"
provider = "local"
model = "bge-m3"

[llm.roles."search.rerank"]
capability = "rerank"
provider = "local_reranker"
model = "BAAI/bge-reranker-v2-m3"

[llm.roles."search.semantic.foreground"]
capability = "embedding"
provider = "semantic_foreground"
model = "nvidia/Nemotron-3-Embed-1B-BF16"

[llm.roles."search.semantic.incremental"]
capability = "embedding"
provider = "semantic_incremental"
model = "nvidia/Nemotron-3-Embed-1B-BF16"

[llm.roles."librarian.review"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."librarian.review.challenger"]
capability = "generation"
provider = "local"
model = "gpt-oss:20b"

[llm.roles."recall.answer.runner"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."recall.answer.scorer"]
capability = "generation"
provider = "local"
model = "gemma4:26b"

[llm.roles."recall.certificate_judge.primary"]
capability = "generation"
provider = "local"
model = "ornith:9b-q4_K_M"

[llm.roles."recall.certificate_judge.escalation"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."ingest.generation"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."lint.tag_repair"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."lint.orphan_link"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."recall.content_correction.proposer"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."recall.auditor"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."recall.gate"]
capability = "generation"
provider = "local"
model = "ornith:9b-q4_K_M"

[llm.roles."recall.query_rewriter"]
capability = "generation"
provider = "local"
model = "ornith:9b-q4_K_M"

[llm.roles."recall.policy_proposer.primary"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"
required_capabilities = ["structured_output"]

[llm.roles."recall.policy_proposer.challenger"]
capability = "generation"
provider = "local"
model = "gemma4:26b"
required_capabilities = ["structured_output"]

[llm.roles."recall.rubric.variant"]
capability = "generation"
provider = "local"
model = "gemma4:26b"
required_capabilities = ["structured_output"]

[llm.roles."research.planner"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"
required_capabilities = ["structured_output"]

[llm.roles."research.challenge"]
capability = "generation"
provider = "local"
model = "gpt-oss:20b"
required_capabilities = ["structured_output"]

[llm.roles."research.tie_break"]
capability = "generation"
provider = "local"
model = "gemma4:26b"
required_capabilities = ["structured_output"]

[llm.roles."research.deep_retrieval_requery"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"
required_capabilities = ["structured_output"]

# Each classification vote remains an independently replaceable single route.
[llm.roles."classification.primary"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.challenger"]
capability = "generation"
provider = "local"
model = "muse-glimmer:30b-mxfp8-dflash"

[llm.roles."classification.tie_break"]
capability = "generation"
provider = "local"
model = "gemma4:26b"

[llm.roles."classification.anchor_set"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.decision"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.direct_decision"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.hierarchy"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.query"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.query_v2"]
capability = "generation"
provider = "local"
model = "maxwell1500/ornith-35b:Q5_K_M"

[llm.roles."classification.anchor"]
capability = "generation"
provider = "local"
model = "gpt-oss:20b"

[llm.roles."classification.anchor.primary"]
capability = "generation"
provider = "local"
model = "gemma4:26b"

[llm.roles."classification.anchor.challenger"]
capability = "generation"
provider = "local"
model = "gpt-oss:20b"

# Cloud-only alternative: one OpenAI credential/profile can serve both roles.
# Store it with `chronovisor credentials set openai/default`; never put its
# value here. Replace the corresponding local role tables above when enabling.
# [llm.providers.openai]
# kind = "openai"
# credential_ref = "oskeyring:openai/default"
#
# [llm.roles."librarian.review"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."librarian.review.challenger"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5"
#
# [llm.roles."recall.answer.runner"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.answer.scorer"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5"
#
# [llm.roles."recall.certificate_judge.primary"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.certificate_judge.escalation"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5"
#
# [llm.roles."recall.auditor"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.gate"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.query_rewriter"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.rubric.variant"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
# required_capabilities = ["structured_output"]
#
# One mixed remote decision role is shown below. All three decision roles must
# resolve to distinct provider/model identities with structured capability.
# Remote voters additionally require an operator-owned immutable revision;
# provider-returned revision/fingerprint fields never replace it.
# [llm.roles."classification.primary"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
# revision = "deployment-2026.08.10-primary"
# required_capabilities = ["structured_output"]
#
# [llm.roles."ingest.generation"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."search.semantic.foreground"]
# capability = "embedding"
# provider = "openai"
# model = "text-embedding-3-large"
#
# [llm.roles."search.semantic.incremental"]
# capability = "embedding"
# provider = "openai"
# model = "text-embedding-3-large"
#
# High-sensitivity/system/raw egress additionally requires a role/data-class pair:
# [[llm.egress_opt_in]]
# role = "librarian.review"
# data_class = "system"
#
# [[llm.egress_opt_in]]
# role = "recall.answer.runner"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.answer.scorer"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.certificate_judge.primary"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.certificate_judge.escalation"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.auditor"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.gate"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.query_rewriter"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.policy_proposer.primary"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.policy_proposer.challenger"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.rubric.variant"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "classification.primary"
# data_class = "system"
#
# role = "research.planner"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "research.challenge"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "research.tie_break"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "research.deep_retrieval_requery"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "ingest.generation"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "ingest.generation"
# data_class = "derived_snippet"
#
# Remote semantic query and sensitive-document routes require these exact pairs:
# [[llm.egress_opt_in]]
# role = "search.semantic.foreground"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "search.semantic.foreground"
# data_class = "system"
#
# [[llm.egress_opt_in]]
# role = "search.semantic.incremental"
# data_class = "page"
#
# [[llm.egress_opt_in]]
# role = "search.semantic.incremental"
# data_class = "system"
#
# Remote reranking validates the raw query and every candidate independently:
# [[llm.egress_opt_in]]
# role = "search.rerank"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "search.rerank"
# data_class = "page"
#
# [[llm.egress_opt_in]]
# role = "search.rerank"
# data_class = "system"
#
# Hybrid note: Anthropic/Claude, DeepSeek, Kimi, and Z.AI/GLM profiles currently
# advertise generation only. Route both `search.semantic.*` roles to a
# separately credentialed OpenAI/Qwen/Gemini/Mistral/OpenRouter profile.
#
# Explicit headless alternatives have no automatic fallback:
# credential_ref = "env:CHRONOVISOR_PROVIDER_SECRET"
# credential_ref = "mounted-file:/run/secrets/chronovisor_provider"
