# Minimal production-supported local-only configuration.
# Copy to ~/.chronovisor/config.toml and keep the destination mode 0600.

[raw]
layout = "v2"

[mcp]
# Raw previews and activity messages require this opt-in plus a per-call flag.
expose_raw_content = false

[hooks.user_prompt]
recall = true

[hooks.stop]
save = true
audit = false
content_correction = true
recall_improve = false

[search.embedding]
enabled = false

[search.reranker]
# Model/provider selection lives only in llm.roles."search.rerank".
enabled = false
top_n = 10
weight = 1.0

[search.reranker.service]
enabled = false
socket = "~/.chronovisor/runtime/reranker.sock"
timeout_ms = 1000
# off | shadow | canary | on
mode = "off"
canary_percent = 0
queue_size = 8

[ingest]
# Numeric generation limits live here; the model is selected only by the
# fixed llm.roles."ingest.generation" route below.
keep_alive = "0"
num_ctx = 114688
max_num_ctx = 262144

[decision_router]
# The cutover uses one pinned oMLX resident model. The quorum field remains
# owned by the decision policy and is intentionally not relaxed here.
authority_kind = "single_model_v1"
single_runtime_role = "classification.authority"
authority_keep_alive = "0"
num_ctx = 114688
max_resident_models = 1
adaptive_residency = true
residency_policy_version = 2
memory_reserve_gib = 16

[research]
enabled = false
mode = "explicit"

[research.web]
adapter_enabled = false
live_egress_enabled = false

[recall.distillation]
# Offline-only. Enabling this starts bounded dataset construction; it never
# changes the live Recall policy by itself.
enabled = false
chunk_size = 25
max_input_bytes = 12000
max_candidates = 200
hard_floor_rallies = 1000
hard_floor_days = 30
hard_floor_windows = 3
hard_floor_teacher_labels = 500
hard_floor_teacher_per_class = 100
hard_floor_probe_pairs = 100
hard_floor_counterfactual_pairs = 100
# OX remains off by default. When enabling its temporary remote profile, set a
# strict future UTC expiry, e.g. 2026-12-31T23:59:59Z.
ox_expires_at = ""
rollout_stages = [5, 25, 100]
canary_min_days = 7

# Dedicated oMLX 0.6.3 service. Per-model residency/PLE/MTP/ANE settings live
# in ~/.omlx/model_settings.json; this endpoint is intentionally loopback-only.
[llm.providers.omlx]
kind = "omlx"
endpoint = "http://127.0.0.1:18125/v1"

[llm.providers.local_reranker]
kind = "local-transformers"
backend = "transformers"
batch_size = 10
max_length = 384

[llm.providers.semantic_foreground]
kind = "nemotron"
device = "mps"

[llm.providers.semantic_incremental]
kind = "nemotron"
device = "cpu"

[llm.roles."knowledge.embedding"]
capability = "embedding"
provider = "omlx"
model = "bge-m3-mlx-fp16"

[llm.roles."knowledge.relation_extraction"]
capability = "generation"
provider = "omlx"
model = "Qwen3.8-Flash-Next-oQ4e-mtp"
revision = "2615fc0e976e65c2f3b55daca3a948f1cdc5b9f8"

[llm.roles."knowledge.community_summary"]
