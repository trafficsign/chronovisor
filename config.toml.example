# Cloud-only alternative: one OpenAI credential/profile can serve both roles.
# Store it with `chronovisor credentials set openai/default`; never put its
# value here. Replace the corresponding local role tables above when enabling.
# [llm.providers.openai]
# kind = "openai"
# credential_ref = "oskeyring:openai/default"
#
# [llm.roles."librarian.review"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."librarian.review.challenger"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5"
#
# [llm.roles."recall.answer.runner"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.answer.scorer"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5"
#
# [llm.roles."recall.certificate_judge.primary"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.certificate_judge.escalation"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5"
#
# [llm.roles."recall.auditor"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.gate"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.query_rewriter"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."recall.rubric.variant"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
# required_capabilities = ["structured_output"]
#
# One mixed remote decision role is shown below. All three decision roles must
# resolve to distinct provider/model identities with structured capability.
# Remote voters additionally require an operator-owned immutable revision;
# provider-returned revision/fingerprint fields never replace it.
# [llm.roles."classification.primary"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
# revision = "deployment-2026.08.10-primary"
# required_capabilities = ["structured_output"]
#
# [llm.roles."ingest.generation"]
# capability = "generation"
# provider = "openai"
# model = "gpt-5-mini"
#
# [llm.roles."search.semantic.foreground"]
# capability = "embedding"
# provider = "openai"
# model = "text-embedding-3-large"
#
# [llm.roles."search.semantic.incremental"]
# capability = "embedding"
# provider = "openai"
# model = "text-embedding-3-large"
#
# High-sensitivity/system/raw egress additionally requires a role/data-class pair:
# [[llm.egress_opt_in]]
# role = "librarian.review"
# data_class = "system"
#
# [[llm.egress_opt_in]]
# role = "recall.answer.runner"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.answer.scorer"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.certificate_judge.primary"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.certificate_judge.escalation"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.auditor"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.gate"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.query_rewriter"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.policy_proposer.primary"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.policy_proposer.challenger"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "recall.rubric.variant"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "classification.primary"
# data_class = "system"
#
# role = "research.planner"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "research.challenge"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "research.tie_break"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "research.deep_retrieval_requery"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "ingest.generation"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "ingest.generation"
# data_class = "derived_snippet"
#
# Remote semantic query and sensitive-document routes require these exact pairs:
# [[llm.egress_opt_in]]
# role = "search.semantic.foreground"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "search.semantic.foreground"
# data_class = "system"
#
# [[llm.egress_opt_in]]
# role = "search.semantic.incremental"
# data_class = "page"
#
# [[llm.egress_opt_in]]
# role = "search.semantic.incremental"
# data_class = "system"
#
# Remote reranking validates the raw query and every candidate independently:
# [[llm.egress_opt_in]]
# role = "search.rerank"
# data_class = "raw"
#
# [[llm.egress_opt_in]]
# role = "search.rerank"
# data_class = "page"
#
# [[llm.egress_opt_in]]
# role = "search.rerank"
# data_class = "system"
#
# Hybrid note: Anthropic/Claude, DeepSeek, Kimi, and Z.AI/GLM profiles currently
# advertise generation only. Route both `search.semantic.*` roles to a
# separately credentialed OpenAI/Qwen/Gemini/Mistral/OpenRouter profile.
#
# Explicit headless alternatives have no automatic fallback:
# credential_ref = "env:CHRONOVISOR_PROVIDER_SECRET"
# credential_ref = "mounted-file:/run/secrets/chronovisor_provider"
