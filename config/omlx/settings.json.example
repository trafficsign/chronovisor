{
  "version": "1.0",
  "server": {
    "host": "127.0.0.1",
    "port": 18125,
    "auto_start_on_launch": true,
    "log_level": "info",
    "sse_keepalive_mode": "chunk",
    "preserve_mid_system_cache": true
  },
  "model": {
    "model_dirs": ["~/.omlx/models"],
    "model_fallback": false,
    "hide_helper_models": false
  },
  "memory": {
    "prefill_memory_guard": true,
    "memory_guard_tier": "custom",
    "memory_guard_custom_ceiling_gb": 104.0,
    "soft_threshold": 0.85,
    "hard_threshold": 0.95,
    "prefill_safe_zone_ratio": 0.8,
    "prefill_min_chunk_tokens": 32
  },
  "scheduler": {
    "max_concurrent_requests": 1,
    "embedding_batch_size": 32,
    "chunked_prefill": false,
    "prefill_priority": "context",
    "decode_fairness": true
  },
  "cache": {
    "enabled": true,
    "hot_cache_only": false,
    "ssd_cache_max_size": "5GB",
    "hot_cache_max_size": "2GB",
    "hot_cache_write_through": false,
    "ane_compile_cache": true,
    "initial_cache_blocks": 256,
    "gdn_ssd_split_enabled": false,
    "gdn_snapshot_storage": "embedded",
    "gdn_ssd_pending_max_size": "512MB",
    "gdn_sidecar_precision": "fp32"
  },
  "sampling": {
    "max_context_window": 114688,
    "max_context_window_policy": 114688,
    "max_tokens": 32768,
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 0,
    "repetition_penalty": 1.0
  },
  "logging": {
    "log_dir": "~/.omlx/logs",
    "retention_days": 7
  },
  "idle_timeout": {
    "idle_timeout_seconds": null
  }
}
