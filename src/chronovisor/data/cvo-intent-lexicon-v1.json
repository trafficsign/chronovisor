{
  "schema": "chronovisor.cvo-intent-lexicon.v1",
  "epoch": "cvo-intent-v1",
  "status": "development",
  "purpose": "High-precision Chronovisor-specific evidence for a complementary anchor. A non-match safely produces no complement.",
  "rules": [
