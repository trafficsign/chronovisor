        {"field": "summary", "pattern": "(?i)(career option|career transition|job application|resume|interview preparation|転職|面接|職務経歴書)"},
        {"field": "excerpt", "pattern": "(?i)(strategic reference for evaluating.{0,80}career option|suitability for engineers transitioning|career transition planning)"}
      ]
    },
    {
