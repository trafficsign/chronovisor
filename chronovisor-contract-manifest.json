{
  "schema": "chronovisor.contract-manifest.v3",
  "canonical": {
    "product": "Chronovisor",
    "distribution": "chronovisor",
    "python_package": "chronovisor",
    "mcp_server": "chronovisor",
    "data_root": "~/.chronovisor",
    "environment_prefix": "CHRONOVISOR_",
    "launchd_prefix": "com.trafficsign.chronovisor-",
    "github": "trafficsign/chronovisor"
  },
  "durable_history": [
    "~/.chronovisor/raw/**",
    "~/.chronovisor/research/**",
    "~/.chronovisor/eval/**",
    "~/.chronovisor-archive/**",
    "~/projects/plan/**"
  ],
  "generic_terms": ["wiki", "page", "raw", "recall"],
  "audit": {
    "forbidden": [
      "llm-wiki-mcp",
      "llm_wiki_mcp",
      "llm-wiki.",
      "LLM Wiki",
      "mcp__llm-wiki__",
      "LLM_WIKI_",
      "~/.wiki",
      "WIKI_SAVE_ENABLED",
      "recall.toml",
      "--only"
    ],
    "allowlisted_paths": [
      "_handoff/**",
      "chronovisor-contract-manifest.json"
    ]
  }
}
