<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@LAUNCHD_LABEL_PREFIX@@deadman</string>

  <key>ProgramArguments</key>
  <array>
    <string>@@PROJECT_ROOT@@/scripts/chronovisor-deadman</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@@PROJECT_ROOT@@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@@HOME@@</string>
    <key>PATH</key>
    <string>@@PATH@@</string>
    <key>CHRONOVISOR_ROOT</key>
    <string>@@HOME@@/.chronovisor</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>@@HOME@@/.chronovisor/logs/deadman.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>@@HOME@@/.chronovisor/logs/deadman.launchd.err.log</string>
</dict>
</plist>
