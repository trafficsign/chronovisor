<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trafficsign.chronovisor-semantic</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/trafficsign/projects/personal/chronovisor/scripts/chronovisor-semantic-service</string>
    <string>serve</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/trafficsign/projects/personal/chronovisor</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/trafficsign</string>
    <key>PATH</key>
    <string>/Users/trafficsign/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/sbin:/usr/sbin:/sbin</string>
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
    <key>TRANSFORMERS_OFFLINE</key>
    <string>1</string>
    <key>TOKENIZERS_PARALLELISM</key>
    <string>false</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>/Users/trafficsign/.chronovisor/logs/semantic.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/trafficsign/.chronovisor/logs/semantic.launchd.err.log</string>
</dict>
</plist>
